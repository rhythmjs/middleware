{
  "name": "@rhythmjs/middleware",
  "version": "0.0.6",
  "description": "Standard Schema v1 validation middleware (body, query, and param) for Rhythm routers and handlers.",
  "keywords": [
    "middleware",
    "rhythm",
    "standard-schema",
    "validation"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/middleware.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./filter": {
      "types": "./dist/filter/filter.d.ts",
      "default": "./dist/filter/filter.js"
    },
    "./intercept": {
      "types": "./dist/intercept/intercept.d.ts",
      "default": "./dist/intercept/intercept.js"
    },
    "./validate": {
      "types": "./dist/validate/validate.d.ts",
      "default": "./dist/validate/validate.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/filter/filter.ts src/intercept/intercept.ts src/validate/validate.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": ">=0.0.14",
    "@rhythmjs/router": ">=0.0.13"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
